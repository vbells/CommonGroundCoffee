@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-center">
    <h1 class="display-4 hero-title">Common Ground Coffee</h1>
</div>

<section class="skew-section skew-left about-section">
    <div class="skew-content container d-flex align-items-center justify-content-between">
        <div class="skew-text">
            <h2>About Us</h2>
            <p>
                Common Ground Coffee is dedicated to providing an exceptional coffee experience.
                Our carefully curated selection of blends and single-origin coffees from around the globe
                reflects our commitment to quality and diversity. We strive to create a space where coffee
                enthusiasts can explore, learn, and indulge in the finest coffee offerings.
            </p>
        </div>
        <div class="skew-image">
            <img src="/images/home/AboutUS.png" alt="Coffee Beans" />
        </div>
    </div>
</section>

<!-- Experience Crafted Coffee Section -->
<section class="skew-section skew-right crafted-coffee-section">
    <div class="skew-content container d-flex align-items-center justify-content-between flex-row-reverse">
        <div class="skew-text">
            <h2>Experience Crafted Coffee</h2>
            <p>
                Discover our diverse selection of coffee blends sourced from around the globe.
                From the rich flavors of Colombia to the unique profiles of Ethiopia and Peru,
                there’s something for every coffee lover. Shop now and explore the world of coffee
                like never before!
            </p>
        </div>
        <div class="skew-image">
            <img src="/images/home/Experience.png" alt="Coffee Cups" />
        </div>
    </div>
</section>

<!-- Sustainable Crafting Practices Section  -->
<section class="skew-section skew-left sustainable-section">
    <div class="skew-content container d-flex align-items-center justify-content-between">
        <div class="skew-text">
            <h2>Sustainable Crafting Practices</h2>
            <p>
                Ethical coffee sourcing is at the heart of our mission. We prioritize direct relationships
                with coffee farmers and producers, ensuring fair compensation and sustainable practices.
                By choosing Common Ground Coffee, you support a more equitable coffee industry and
                contribute to positive change.
            </p>
        </div>
        <div class="skew-image">
            <img src="/images/home/Sustainable.png" alt="Sustainable Coffee" />
        </div>
    </div>
</section>
