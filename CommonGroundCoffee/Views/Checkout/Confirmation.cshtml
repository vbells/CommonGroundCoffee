@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="text-center mt-5">
    <h2 class="text-success">Order Placed!</h2>
    <p class="mt-3">Thank you for your order!</p>
    <div class="d-flex justify-content-center gap-3 mt-4">
        <a asp-controller="Checkout" asp-action="OrderHistory" class="btn btn-outline-primary">View Order History</a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
    </div>
</div>