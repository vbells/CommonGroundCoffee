@model CommonGroundCoffee.ViewModels.CafesNearMeViewModel
@{
    ViewData["Title"] = "Cafes Near Me";
    bool searchDone = Model.SearchPerformed && Model.Results.Any();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4" style="max-width:720px;">

    <h2 class="text-center mb-1" style="font-family:Georgia,serif;">Cafes Near Me</h2>
    <p class="text-center text-muted mb-4">Personalized recommendations based on your taste and location.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (!searchDone)
    {
        <!-- SEARCH FORM -->
        <form asp-controller="Cafe" asp-action="Search" method="post">

            <!-- Location -->
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="fw-bold mb-1">Location</h5>
                    <p class="text-muted small mb-3">Enter your address or use your current location.</p>

                    <input asp-for="Address" class="form-control mb-2"
                           placeholder="e.g. 123 Main St, Chicago, IL" />

                    <button type="button" class="btn btn-outline-secondary btn-sm w-100"
                            onclick="getLocation()">
                        Use My Current Location
                    </button>

                    <p id="location-status" class="text-success small mt-2" style="display:none;">
                        Location detected.
                    </p>

                    <input type="hidden" asp-for="Latitude" id="Latitude" />
                    <input type="hidden" asp-for="Longitude" id="Longitude" />
                </div>
            </div>

            <!-- Preferences -->
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="fw-bold mb-1">Preferences</h5>
                    <p class="text-muted small mb-2">Based on your past purchases and anything you add below.</p>

                    @if (Model.PurchasedProducts.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var product in Model.PurchasedProducts)
                            {
                                <span class="badge bg-secondary">@product</span>
                            }
                        </div>
                    }

                    <input asp-for="ManualPreferences" class="form-control"
                           placeholder="e.g. oat milk, quiet atmosphere, outdoor seating" />
                    <div class="form-text">Add anything extra you're looking for in a cafe.</div>
                </div>
            </div>

            <!-- Distance -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-1">Distance</h5>
                    <p class="text-muted small mb-3">How far are you willing to travel?</p>

                    <div class="d-flex align-items-center gap-3">
                        <span class="small">1 mi</span>
                        <input asp-for="RadiusMiles" type="range" class="form-range flex-grow-1"
                               min="1" max="50" step="1"
                               oninput="document.getElementById('radius-display').textContent = this.value" />
                        <span class="fw-bold" style="min-width:60px;">
                            <span id="radius-display">@Model.RadiusMiles</span> mi
                        </span>
                    </div>
                </div>
            </div>

            <div id="loading" class="text-center mb-3" style="display:none;">
                <div class="spinner-border spinner-border-sm text-dark me-1"></div>
                Finding cafes near you...
            </div>

            <button type="submit" class="btn w-100 text-white mb-5"
                    style="background:#1a1a1a;"
                    onclick="document.getElementById('loading').style.display='block'">
                Find My Cafe
            </button>

        </form>
    }
    else
    {
        <!-- RESULTS PAGE -->
        <div id="map" style="height:320px; border-radius:8px; margin-bottom:24px;"></div>

        @foreach (var cafe in Model.Results)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-2">@cafe.Name</h5>
                    <p class="mb-1 small">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <strong>Address:</strong> @cafe.Address
                    </p>
                    <p class="mb-1 small">
                        <i class="bi bi-signpost-split"></i>
                        <strong>Distance:</strong> @cafe.Distance
                    </p>
                    <p class="mb-2 small">
                        <i class="bi bi-stars text-warning"></i>
                        <strong>Match:</strong> @cafe.WhyItMatches
                    </p>
                    <a href="https://www.google.com/search?q=@Uri.EscapeDataString(cafe.Name + " " + cafe.Address)"
                       target="_blank"
                       class="btn btn-sm text-white" style="background:#1a1a1a;">
                        Learn More
                    </a>
                </div>
            </div>
        }

        <div class="text-center mb-5">
            <a asp-controller="Cafe" asp-action="Index" class="btn btn-outline-secondary">
                Update Preferences
            </a>
        </div>
    }

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    function getLocation() {
        if (!navigator.geolocation) {
            alert('Geolocation not supported by your browser.');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (pos) {
            document.getElementById('Latitude').value = pos.coords.latitude;
            document.getElementById('Longitude').value = pos.coords.longitude;
            document.getElementById('Address').value = '';
            document.getElementById('location-status').style.display = 'block';
        }, function () {
            alert('Could not get location. Please enter your address manually.');
        });
    }

    @if (searchDone)
    {
            <text>
            var map = L.map('map');
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            var cafes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results));
            var bounds = [];

            cafes.forEach(function (cafe) {
                fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(cafe.address))
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.length > 0) {
                            var lat = parseFloat(data[0].lat);
                            var lon = parseFloat(data[0].lon);
                            L.marker([lat, lon])
                                .addTo(map)
                                .bindPopup('<b>' + cafe.name + '</b><br>' + cafe.address + '<br>' + cafe.distance);
                            bounds.push([lat, lon]);
                            if (bounds.length > 0) map.fitBounds(bounds, { padding: [40, 40] });
                        }
                    });
            });

            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
            {
                    <text>
                    L.circleMarker([@Model.Latitude, @Model.Longitude], {
                        radius: 8, fillColor: '#4285F4', color: '#fff', weight: 2, fillOpacity: 1
                    }).addTo(map).bindPopup('Your location');
                    map.setView([@Model.Latitude, @Model.Longitude], 13);
                    </text>
            }
            else
            {
                    <text>
                    map.setView([41.8827, -87.6233], 12);
                    </text>
            }
            </text>
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}