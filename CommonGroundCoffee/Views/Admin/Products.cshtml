@model IEnumerable<DataAccessLayer.Entities.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Products</h6>
        <a asp-controller="Admin" asp-action="AddProduct" class="btn btn-primary btn-sm">
            + Add New Product
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Product_ID</td>
                            <td>@product.Product_Name</td>
                            <td>@product.Product_Type</td>
                            <td>@product.Unit_Price.ToString("C")</td>
                            <td>@product.Quantity_Available</td>
                            <td>
                                <a asp-controller="Admin" asp-action="EditProduct"
                                   asp-route-id="@product.Product_ID"
                                   class="btn btn-sm btn-secondary">Edit</a>

                                <form asp-controller="Admin" asp-action="DeleteProduct" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete @product.Product_Name?')">
                                    <input type="hidden" name="id" value="@product.Product_ID" />
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>