@model DataAccessLayer.Entities.Product
\

<div class="container py-5">

    <div class="row">

        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 class="img-fluid rounded shadow-sm"
                 alt="@Model.Product_Name" />
        </div>

        <div class="col-md-6">
            <h2>@Model.Product_Name</h2>
            <p class="text-muted">@Model.Product_Type</p>

            <hr />

            <p>@Model.Description</p>

            <h4 class="mt-4">@Model.Unit_Price.ToString("C")</h4>

            <p class="mt-2">
                <strong>Quantity Available:</strong> @Model.Quantity_Available
            </p>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Product_ID" />

                <button type="submit" class="btn btn-dark mt-3">Add to Cart</button>
            </form>
        </div>

    </div>

</div>